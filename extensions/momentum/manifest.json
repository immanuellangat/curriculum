{
  "manifest_version": 3,
  "name": "Focus Plus",
  "version": "1.0.0",
  "description": "A calm, focused new-tab dashboard with a daily focus and simple to-do list.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "tabs", "contentSettings", "declarativeNetRequest"],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}
